generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Assessment {
  id         Int      @id @default(autoincrement()) @map("Assessment_ID")
  createdBy  String
  targetUser String
  date       DateTime @default(now()) @map("Date")
  groupId    String   @map("GroupID")

  hardSkills HardSkill[]
  softSkills SoftSkillsTable[]

  @@map("Assessments")
}

model HardSkillsSection {
  id         Int         @id @default(autoincrement()) @map("Question_ID")
  text       String      @map("Text")
  hardSkills HardSkill[]

  @@map("HardSkillsSections")
}

model HardSkillsMark {
  id         Int         @id @default(autoincrement()) @map("Mark_ID")
  text       String      @map("Text")
  hardSkills HardSkill[]

  @@map("HardSkillsMarks")
}

model HardSkill {
  assessmentId Int @map("Assessment_ID")
  questionId   Int @map("Question_ID")
  markId       Int @map("Mark_ID")

  assessment Assessment        @relation(fields: [assessmentId], references: [id])
  section    HardSkillsSection @relation(fields: [questionId], references: [id])
  mark       HardSkillsMark    @relation(fields: [markId], references: [id])

  @@id([assessmentId, questionId])
  @@map("HardSkills")
}

model Area {
  id           Int               @id @default(autoincrement()) @map("Area_ID")
  text         String            @unique @map("Text")
  competencies Competency[]
  softSkills   SoftSkillsTable[]

  @@map("Areas")
}

model Competency {
  areaId       Int    @map("Area_ID")
  competencyId Int    @map("Competency_ID")
  text         String @map("Text")

  area       Area              @relation(fields: [areaId], references: [id])
  softSkills SoftSkillsTable[]

  @@id([areaId, competencyId])
  @@map("Competencies")
}

model SoftSkillsMark {
  id         Int               @id @default(autoincrement()) @map("Mark_ID")
  text       String            @unique @map("Text")
  comments   Comment[]
  softSkills SoftSkillsTable[]

  @@map("SoftSkillsMarks")
}

model SoftSkillsTable {
  assessmentId Int @map("Assessment_ID")
  areaId       Int @map("Area_ID")
  competencyId Int @map("Competency_ID")

  key Int @unique @default(dbgenerated()) @map("KEY")

  assessment       Assessment      @relation(fields: [assessmentId], references: [id])
  area             Area            @relation(fields: [areaId], references: [id])
  competency       Competency      @relation(fields: [areaId, competencyId], references: [areaId, competencyId])
  comments         Comment[]
  SoftSkillsMark   SoftSkillsMark? @relation(fields: [softSkillsMarkId], references: [id])
  softSkillsMarkId Int?

  @@id([assessmentId, areaId, competencyId])
  @@map("SoftSkillsTable")
}

model Comment {
  id          Int    @id @default(autoincrement()) @map("Comment_ID")
  key         Int    @map("KEY")
  markId      Int    @map("Mark_ID")
  commentText String @map("Comment")

  softSkill SoftSkillsTable @relation(fields: [key], references: [key])
  mark      SoftSkillsMark  @relation(fields: [markId], references: [id])

  @@map("Comments")
}
