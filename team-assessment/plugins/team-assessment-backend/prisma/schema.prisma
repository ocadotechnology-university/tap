 generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assessment {
  assessmentId Int      @id @default(autoincrement()) @map("Assessment_ID")
  createdBy    String   @map("createdBy")
  targetUser   String   @map("targetUser")
  date         DateTime @map("Date")
  groupId      Int?     @map("GroupID")

  hardSkills HardSkill[]       @relation("AssessmentToHardSkills")
  softSkills SoftSkillsTable[]

  @@map("Assessments")
}

model HardSkillsMark {
  markId Int    @id @map("Mark_ID")
  text   String @map("Text")

  hardSkills HardSkill[] @relation("HardSkillsToHardSkillsMark")

  @@map("HardSkillsMarks")
}

model SoftSkillsMark {
  markId Int    @id @map("Mark_ID")
  text   String @map("Text")

  comments Comment[] @relation("SoftSkillsMarkToComments")

  @@map("SoftSkillsMarks")
}

model Area {
  areaId Int    @id @map("Area_ID")
  text   String @map("Text")

  softSkills SoftSkillsTable[]

  @@map("Areas")
}

model Competency {
  competencyId Int    @id @map("Competency_ID")
  text         String @map("Text")

  hardSkills HardSkill[]       @relation("CompetencyToHardSkills")
  softSkills SoftSkillsTable[]

  @@map("Competencies")
}

model HardSkill {
  assessment   Assessment @relation("AssessmentToHardSkills", fields: [assessmentId], references: [assessmentId], onDelete: Cascade, onUpdate: Cascade)
  assessmentId Int        @map("Assessment_ID")

  competency Competency @relation("CompetencyToHardSkills", fields: [questionId], references: [competencyId], onDelete: Restrict, onUpdate: Cascade)
  questionId Int        @map("Question_ID")

  mark   HardSkillsMark @relation("HardSkillsToHardSkillsMark", fields: [markId], references: [markId], onDelete: Restrict, onUpdate: Cascade)
  markId Int            @map("Mark_ID")

  @@id([assessmentId, questionId])
  @@map("HardSkills")
}

model SoftSkillsTable {
  key Int @id @map("KEY")

  assessment   Assessment @relation(fields: [assessmentId], references: [assessmentId], onDelete: Cascade, onUpdate: Cascade)
  assessmentId Int        @map("Assessment_ID")

  area   Area @relation(fields: [areaId], references: [areaId], onDelete: Restrict, onUpdate: Cascade)
  areaId Int  @map("Area_ID")

  competency   Competency @relation(fields: [competencyId], references: [competencyId], onDelete: Restrict, onUpdate: Cascade)
  competencyId Int        @map("Competency_ID")

  comments Comment[] @relation("SoftSkillsTableToComments")

  @@unique([assessmentId, areaId, competencyId])
  @@map("SoftSkillsTable")
}

model Comment {
  commentId Int @id @default(autoincrement()) @map("Comment_ID")

  softSkill    SoftSkillsTable @relation("SoftSkillsTableToComments", fields: [softSkillKey], references: [key])
  softSkillKey Int             @map("KEY")

  mark   SoftSkillsMark @relation("SoftSkillsMarkToComments", fields: [markId], references: [markId])
  markId Int            @map("Mark_ID")

  comment String @map("Comment")

  @@map("Comments")
}